# ESP-IDF build output
/m5tab5/build/
/m5tab5/sdkconfig
/m5tab5/sdkconfig.old
/m5tab5/managed_components/
# 8087: the ELF's own build (elf/CMakeLists.txt): the component manager's
# copy of the managed components, and what a build of elf/ on its own writes.
/m5tab5/elf/managed_components/
/m5tab5/elf/sdkconfig
/m5tab5/elf/sdkconfig.old
/m5tab5/elf/build-elf/
# Written by the CI build step from the release string into
# esp_app_desc_t.version; never committed (local builds fall back to
# git describe). See .github/workflows/main.yml.
/m5tab5/version.txt

# minimp3: fetched by cmake/vendored.cmake during idf.py build, pinned to
# a commit and SHA256-checked. Nothing to run by hand. (pngle, stb_image
# and J40 are feckless_image_handler's, in managed_components/.)
/m5tab5/components/minimp3/minimp3.h
/m5tab5/components/minimp3/minimp3_ex.h
/m5tab5/components/esp_lcd/

# Download temporaries from a failed or interrupted vendored fetch.
*.tmp

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# texttest host build artefacts.
#
# Every binary the Makefile builds, by name rather than by pattern:
# texttest/ holds the sources too, and a pattern loose enough to catch
# nineteen extensionless binaries also catches a .c file somebody
# forgot the extension on. `make clean` removes these; the list is
# here so a tree that has been built still reads as clean.
m5tab5/texttest/texttest
m5tab5/texttest/remoteprototest
m5tab5/texttest/brightnesstest
m5tab5/texttest/bufferplantest
m5tab5/texttest/cachetest
m5tab5/texttest/clocktest
m5tab5/texttest/codecplantest
m5tab5/texttest/ctrltest
m5tab5/texttest/fadetest
m5tab5/texttest/framewintest
m5tab5/texttest/icydemuxtest
m5tab5/texttest/netplantest
m5tab5/texttest/portalwebtest
m5tab5/texttest/radiobrowsertest
m5tab5/texttest/sleeptimertest
m5tab5/texttest/stationlisttest
m5tab5/texttest/stationnavtest
m5tab5/texttest/streamplantest
m5tab5/texttest/streamsnifftest
m5tab5/texttest/tailplantest
m5tab5/texttest/wifistoretest
m5tab5/texttest/micpcmtest
m5tab5/texttest/*.dSYM/

# git format-patch output. Patch files contain trailing whitespace by
# construction -- context lines, and the "-- " before the version
# trailer -- so committing them makes `git am` report hundreds of
# whitespace errors on every subsequent patch that touches the
# directory. See the patch that removed out/.
/out/
/allpatches/
/patches/
*.patch

# python bytecode from tools/
__pycache__/
*.pyc
m5tab5/texttest/levelhisttest

# u-defeatist-0002: boxwin, a project of its own (m5tab5/boxwin/README.md).
# Its dependencies.lock is not listed: it records the commit of
# feckless-libs' umode branch a measurement was taken with.
/m5tab5/boxwin/build/
/m5tab5/boxwin/sdkconfig
/m5tab5/boxwin/sdkconfig.old
/m5tab5/boxwin/managed_components/
/m5tab5/boxwin/test/boxwinhost
/m5tab5/boxwin/test/boxwinmaths
