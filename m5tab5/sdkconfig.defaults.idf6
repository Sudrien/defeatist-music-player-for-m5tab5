# sdkconfig.defaults.idf6 -- read after sdkconfig.defaults (the top-level
# CMakeLists.txt adds it). The options that are IDF 6's own; the name is
# from when there was an IDF 5 build as well.
#
# Like sdkconfig.defaults, this only seeds a NEW sdkconfig: rm sdkconfig
# after changing it. cmake/defaults_check.cmake reads this file too.

# ---------------------------------------------------------------------------
# X.509 CERTIFICATE WRITING, FOR THE REMOTE'S OWN CERTIFICATE.
#
# certgen.c writes the self-signed certificate the remote serves HTTPS
# with. IDF 6 puts mbedTLS's X.509 writer behind
# this, default off, and certgen.c does not compile without it.
CONFIG_MBEDTLS_X509_CREATE_C=y

# ---------------------------------------------------------------------------
# THE C LIBRARY IS PICOLIBC, AS THE FECKLESS ABI IS.
#
# IDF 6's default, written down here so that nothing selects newlib again:
# the player is an ELF that the launcher loads (elf/), and everything it
# calls that it does not define is the ABI's, which is picolibc's
# (`_ctype_b`, `__errno`, `fputc` and `stdout` are in feckless_abi's
# exports.txt). feckless_abi stops the configure on newlib. Picolibc's
# `errno` is a thread-local, which an ELF's link refuses ("R_RISCV_TPREL_HI20
# against `errno' can not be used when making a shared object"); feckless_abi
# adds -D__PICOLIBC_ERRNO_FUNCTION=__errno to the compile, so `errno` is a
# call to `__errno()`. 8134 selected newlib instead, before that existed.
# Like the rest of this file it seeds a NEW sdkconfig: rm sdkconfig after
# changing it, and a configuration carried over from 8134 has newlib until
# you do.
CONFIG_LIBC_PICOLIBC=y
